# Written by Claude Code at each mod load; regenerated, never edited.
claude/mods/*/.claude-plugin/types/
.DS_Store

# Source images and audio you supply yourself are personal use only; never commit them.
# Mod themes live in ~/.claude/theme-cli/, outside the repo.
scratch/
.claude/worktrees/

# Per-project skill and agent copies made by scripts/install-skills.sh and install-agents.sh.
# This repo's own project folder ignores them: the copies are not kept in this repository.
.claude/skills/
.claude/agents/
.agents/skills/

# Third-party skills and plugins fetched by scripts/fetch-skills.sh, at the commit in skills.lock.json.
.cache/

# Python bytecode caches made by test runs.
__pycache__/
